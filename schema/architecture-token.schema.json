{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecturetokens.org/schema/architecture-token.schema.json",
  "title": "Architecture Token",
  "description": "A reusable semantic unit for software architecture.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "category",
    "description"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/tokenId"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "component",
        "relationship"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "$ref": "#/$defs/slugList"
    },
    "constraints": {
      "$ref": "#/$defs/slugList"
    },
    "mappings": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/slug"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "relationships": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/tokenId"
      }
    },
    "tags": {
      "$ref": "#/$defs/slugList"
    },
    "aliases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "category": {
            "const": "component"
          }
        },
        "required": [
          "category"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^component\\."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "relationship"
          }
        },
        "required": [
          "category"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^relationship\\."
          }
        }
      }
    }
  ],
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "slugList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "tokenId": {
      "type": "string",
      "pattern": "^(?:component|relationship)\\.[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9-]*)*$"
    }
  }
}
