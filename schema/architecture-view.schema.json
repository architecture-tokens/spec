{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architecturetokens.org/schema/architecture-view.schema.json",
  "title": "Architecture View",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "version", "id", "model", "mode", "flow", "components", "relationships", "visualElements"],
  "properties": {
    "kind": { "const": "view" },
    "version": { "const": "0.1.0" },
    "id": { "$ref": "#/$defs/id" },
    "model": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["reproduce", "restyle"] },
    "reason": { "type": "string", "minLength": 1 },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction"],
      "properties": {
        "direction": { "enum": ["up", "down", "left", "right", "mixed"] }
      }
    },
    "components": { "$ref": "#/$defs/attachmentOwners" },
    "relationships": { "$ref": "#/$defs/attachmentOwners" },
    "visualElements": {
      "type": "array",
      "items": { "$ref": "#/$defs/visualElement" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
    },
    "offset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dx", "dy"],
      "properties": {
        "dx": { "type": "number" },
        "dy": { "type": "number" }
      }
    },
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["icon", "anchor"],
      "properties": {
        "icon": { "type": "string", "minLength": 1 },
        "anchor": {
          "enum": [
            "top-left",
            "top-center",
            "top-right",
            "middle-left",
            "middle-center",
            "middle-right",
            "bottom-left",
            "bottom-center",
            "bottom-right",
            "edge-start",
            "edge-midpoint",
            "edge-end"
          ]
        },
        "offset": { "$ref": "#/$defs/offset" }
      }
    },
    "attachments": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/attachment" }
    },
    "attachmentOwners": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/attachments" }
    },
    "visualElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "members"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "members": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "attachments": { "$ref": "#/$defs/attachments" }
      }
    }
  }
}
